{
  "expo": {
    "name": "kangaroo",
    "slug": "kangaroo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "kangaroo",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "entitlements": {
          "com.apple.developer.healthkit": true
        },
      "supportsTablet": true,
      "bundleIdentifier": "com.sparring.kangaroo",
      "newArchEnabled": false,
        "infoPlist": {
          "NSHealthShareUsageDescription": "걸음 수와 건강 데이터를 읽어 운동 기록 서비스를 제공합니다.",
          "NSHealthUpdateUsageDescription": "건강 데이터를 저장하여 운동 기록 서비스를 제공합니다.",
          "NSAppTransportSecurity": {
            "NSExceptionDomains": {
              "43.202.179.177": {
                "NSExceptionAllowsInsecureHTTPLoads": true,
                "NSIncludesSubdomains": true
              }
            }
          }
}
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#ffffff"
      },
      "package": "com.sparring.kangaroo",
      "usesCleartextTraffic": true,
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "@react-native-community/datetimepicker",
      "expo-font",
      "expo-secure-store",
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "15.1"
          },
          "android": {
            "extraMavenRepos": [
              "https://devrepo.kakao.com/nexus/content/groups/public/"
            ]
          }
        }
      ],
      [
        "@react-native-seoul/kakao-login",
        {
          "kakaoAppKey": "d9de37c241c38fd01edd123959ea5b0c"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
